generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Project {
  id              String   @id @default(uuid())
  number          String
  name            String
  type            String
  description     String
  longDescription String?
  technologies    String   // JSON string of string[]
  images          String   // JSON string of string[]
  metrics         String?  // JSON string of {label: string, value: string}[]
  liveUrl         String?
  featured        Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Moment {
  id          String   @id @default(uuid())
  title       String
  category    String   // WORK, HOMETOWN, TRAVEL, LIFESTYLE
  location    String?
  aspectRatio String   @default("landscape") // portrait, landscape, square, wide
  image       String
  caption     String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model JourneyStep {
  id          String   @id @default(uuid())
  number      String
  stage       String
  period      String
  title       String
  description String
  tags        String   // JSON string of string[]
  sortOrder   Int      @default(0)
}

model ContactMessage {
  id          String   @id @default(uuid())
  name        String
  contactInfo String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model SiteSetting {
  key       String   @id
  value     String   // JSON string
  updatedAt DateTime @updatedAt
}

