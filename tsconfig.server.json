{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "outDir": "./dist-server",
    "rootDir": ".",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["server/src/**/*", "api/**/*"],
  "exclude": ["node_modules", "dist", "dist-server", "src"]
}
