# ============================================================
# BACKEND-ONLY VARIABLES (không dùng prefix VITE_)
# Chỉ server đọc — KHÔNG BAO GIỜ expose ra frontend bundle
# ============================================================

# Server port (local dev only — Vercel tự quản lý port)
PORT=5000

# ========================
# DATABASE (Supabase PostgreSQL)
# Lấy từ: Supabase → Settings → Database → Connection string
# ========================

# LOCAL: SQLite (dev only, không cần PostgreSQL)
DATABASE_URL="file:./dev.db"
DIRECT_URL="file:./dev.db"

# PRODUCTION: Supabase PostgreSQL
# Transaction pooler (port 6543) — dùng cho runtime queries
# DATABASE_URL="postgresql://postgres.xxx:[password]@aws-0-xxx.pooler.supabase.com:6543/postgres"

# Session pooler (port 5432) — dùng cho migrations & Prisma Studio
# DIRECT_URL="postgresql://postgres.xxx:[password]@aws-0-xxx.pooler.supabase.com:5432/postgres"

# ========================
# AUTH
# ========================
JWT_SECRET="your_random_jwt_secret_here_minimum_32_chars"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_this_password"

# ========================
# SUPABASE STORAGE (upload ảnh)
# Lấy từ: Supabase Dashboard → Settings → API
# ========================
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="eyJ..."
# SERVICE_ROLE_KEY chỉ backend — KHÔNG dùng VITE_ prefix
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ========================
# CORS (tùy chọn)
# Nếu để trống, Vercel production tự động cho phép same-domain
# ========================
# FRONTEND_URL="https://trungluanmmo.vercel.app"

# ============================================================
# FRONTEND-SAFE VARIABLES (prefix VITE_)
# Được bundle vào React app — KHÔNG được chứa secret
# ============================================================

# API URL cho frontend:
# - Để TRỐNG khi deploy Vercel (frontend và backend cùng domain → dùng /api)
# - Set khi backend chạy riêng server (Railway, local dev với backend remote)
# VITE_API_URL=

# ============================================================
# OPTIONAL FEATURES
# ============================================================

# Telegram Bot — báo tin nhắn mới về điện thoại
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Google Gemini Vision — AI phân tích ảnh
GEMINI_API_KEY=""
